# Copy file nay thanh .env tai thu muc goc. Huong dan: HUONG_DAN_CHAY.md, muc 6.
# V1 lay market data public: khong can Binance API key/secret.
# Chi chia se/push file mau nay; .env la cau hinh rieng tung may.

# spot hoac futures (USD-M Futures).
BINANCE_MARKET=spot
# De trong: tu chon api.binance.com (Spot) hoac fapi.binance.com (Futures).
# Neu tu dat URL, chi ghi host; khong them /api/v3 hoac /fapi/v1.
BINANCE_BASE_URL=
# Timeout moi request, don vi giay, phai > 0.
BINANCE_TIMEOUT_SECONDS=10
# Tong so lan thu cho loi mang/5xx: 1-5, gom ca lan dau.
BINANCE_MAX_ATTEMPTS=3
# Mat khau Redis (bat buoc voi Docker Compose). Tao bang: openssl rand -hex 24
REDIS_PASSWORD=change-me
# Python local dung URL nay (can mat khau). Docker Compose tu dat redis://:<password>@redis:6379/0.
REDIS_URL=redis://:change-me@localhost:6379/0
# Cache nen moi, don vi giay, so nguyen >= 1. Khong phai lich tu fetch.
CACHE_TTL_SECONDS=60
# Tong thoi gian giu ban nen du phong tu luc fetch; phai > CACHE_TTL_SECONDS.
STALE_TTL_SECONDS=3600
# Cache danh sach symbol USDT, don vi giay, so nguyen >= 1.
SYMBOLS_TTL_SECONDS=3600
# DEBUG, INFO, WARNING hoac ERROR (viet hoa).
LOG_LEVEL=INFO
# Port API tren host khi dung Docker. Doi thanh 8001 neu 8000 dang ban.
# Uvicorn local chon port qua --port, khong doc API_PORT.
API_PORT=8000

# Telegram watcher: chi bat khi chu dong muon gui tin that. Mot worker/replica.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=10
# Message display timezone only; scheduler remains UTC. Alternative: UTC.
TELEGRAM_TIMEZONE=Asia/Ho_Chi_Minh
# Test live khong tu bat khi co credentials.
RUN_TELEGRAM_LIVE_TESTS=0
RUN_OPENAI_LIVE_TESTS=0

# AI chatbot + phan tich kem canh bao Telegram. Key chi o backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=60
AI_ENABLED=true
TELEGRAM_AI_ENABLED=true
TELEGRAM_AI_LANGUAGE=vi
TELEGRAM_AI_TIMEOUT_SECONDS=8
AI_CHAT_REQUESTS_PER_MINUTE=6

# Manual AI -> Telegram diagnostic; independent of TELEGRAM_ENABLED.
# Disabled by default. Use a random secret of 24-256 characters, never a VITE_* variable.
TELEGRAM_TEST_ENABLED=false
TELEGRAM_TEST_KEY=
