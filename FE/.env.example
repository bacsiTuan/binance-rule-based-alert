# Copy file này thành .env trong thư mục FE.
# false = lấy symbol và chỉ báo thật từ backend. true = thử UI với symbol/rule mẫu.
VITE_USE_MOCK=false
# Đích proxy /api của Vite. Đổi cổng nếu API_PORT trong .env gốc khác 8000.
VITE_API_TARGET=http://localhost:8000
# Tên miền public được phép mở FE (npm start / dev), cách nhau bởi dấu phẩy. "*" = mọi host.
# Ví dụ: VITE_ALLOWED_HOSTS=ec2-47-131-72-191.ap-southeast-1.compute.amazonaws.com
VITE_ALLOWED_HOSTS=
# Manual Telegram test key is read server-side from the root .env automatically.
# Never put TELEGRAM_TEST_KEY or other credentials in a VITE_* variable.
